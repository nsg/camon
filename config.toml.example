# Camon Configuration

[update]
# Auto-update from GitHub Releases on startup (default: true)
enabled = true

[buffer]
# Hot buffer duration in seconds (default: 600 = 10 minutes)
hot_duration_secs = 600

[http]
# HTTP server port for web UI and API (default: 8080)
port = 8080

[analytics]
# Enable MOG2 motion detection (default: false)
enabled = true
# Frame sample rate for analysis (default: 5)
sample_fps = 5

# Default motion-detection settings. These seed each camera's
# motion_settings.json the first time it is seen; after that the per-camera
# file — edited live from the web UI (sensitivity slider, min-object-size
# slider, and two paintable 16x12 masks: the movement mask, which excludes
# cells from motion detection, and the detection mask, which blacks cells out
# of every frame sent to the vision model) — takes over. Detection is fully
# deterministic: there is no auto-tuning. Only the two sliders have config
# defaults; both masks default to all-off and are painted per camera.
[analytics.motion]
# MOG2 var_threshold. Higher = less sensitive. Range 4-96 (default: 16).
var_threshold = 16
# Minimum object size in foreground pixels. Range 50-2000 (default: 200).
min_contour_area = 200

# Object detection via Ollama (requires analytics enabled).
# All cameras share ONE detection worker that sends at most one request to
# Ollama at a time (strictly serial — kind to modest GPUs). Motion detection
# and event recording never wait for the model: events are written the moment
# a motion run ends and upgraded to object events when a verdict arrives.
[analytics.object_detection]
# Enable object detection on motion segments (default: false)
enabled = true
# Minimum confidence threshold (default: 0.5)
confidence_threshold = 0.5
# Object classes to detect (default: person, car, truck, dog, cat).
# Also constrains the model's structured JSON output — only these classes can
# be returned.
classes = ["person", "car", "truck", "dog", "cat"]

[analytics.object_detection.ollama]
# Ollama server URL (default: http://localhost:11434)
url = "http://localhost:11434"
# Vision model to use (default: gemma4:e4b)
model = "gemma4:e4b"
# Per-request timeout in seconds (default: 90). Warm inference on a modest
# GPU takes up to ~50s per frame; a timeout only costs that event's object
# upgrade, never the footage.
timeout_secs = 90

# Optional fallback server if primary fails
# [analytics.object_detection.ollama.fallback]
# url = "http://backup:11434"
# model = "gemma3:4b"

[storage]
# Enable warm storage — write video to disk (default: true).
# With analytics enabled this is EVENT recording: only motion/object events are
# saved (to movements/ and objects/). With analytics DISABLED it becomes
# CONTINUOUS recording ("dumb NVR"): every segment is saved, chunked into
# continuous/. Continuous is heavy — roughly 43 GB/day/camera at 4 Mbps.
enabled = true
# Directory for event files (default: /var/camon/storage)
data_dir = "/var/camon/storage"
# Seconds of context before first motion in an event (default: 5)
pre_padding_secs = 5
# Seconds of context after last motion in an event (default: 10)
post_padding_secs = 10
# Cap on a single event's length in seconds (default: 120). A run longer than
# this is split into chained, independently playable chunks — the follow-on
# chunks are flagged "continues" in their sidecar. In continuous mode this is
# also the length of each recording chunk. 0 disables the cap. Timing is
# monotonic (wall clock), so a camera PTS jump can't stall it.
max_event_duration_secs = 120
# Retention for movement-only events in days (default: 2)
movement_retention_days = 2
# Retention for object detection events in days (default: 14)
object_retention_days = 14
# Retention for continuous-recording chunks in days (default: 1). Kept short by
# default because continuous recording is ~43 GB/day/camera at 4 Mbps.
continuous_retention_days = 1
# Minimum free space (bytes) to keep on the storage filesystem (default:
# 2147483648 = 2 GiB). Before each event write, if free space is below this,
# the oldest recordings are emergency-pruned — continuous first, then
# movements, then objects (cheapest to lose first) — until space recovers.
# 2 GiB is roughly an hour of footage at 4 Mbps, enough slack for the hourly
# retention prune to catch up, and keeps the filesystem out of the near-full
# regime where allocation degrades. 0 disables the guard.
min_free_bytes = 2147483648

# Camera definitions — add one [[cameras]] block per camera

[[cameras]]
id = "front-door"
url = "rtsp://admin:password@192.168.1.100:554/stream1"

# [[cameras]]
# id = "backyard"
# url = "rtsp://admin:password@192.168.1.101:554/stream1"
