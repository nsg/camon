# Camon Configuration
#
# Camon loads this file as ./config.toml by default. Point it anywhere with
# --config, and override individual values at startup with --set:
#   camon --config /path/to/config.toml --set http.port=9090
# A --set value is typed from the setting it names, not from how it looks, so
# a numeric-looking string stays a string (--set mqtt.password=12345).
# (The Home Assistant add-on uses both; see HOMEASSISTANT.md.)
#
# The whole file is validated before anything starts, and camon exits with the
# problem rather than running on defaults: a key it does not know is an error
# (a typo would otherwise silently leave the default in force), while keys camon
# itself shipped and later removed are dropped with advice, so a config that
# booted before keeps booting.

[update]
# Auto-update from GitHub Releases on startup and every 12 hours (default:
# false). A download is checked against the release's sha256sums.txt and a
# release that publishes none is refused; that catches a corrupt download but
# is not a signature, so this stays opt-in.
# Before the running binary is replaced, the downloaded one is run as
# `camon version` and must report exactly the version its release is tagged
# with — a tag that does not match its asset would leave the tag still looking
# newer after the restart, and camon would fetch it again after every restart.
# Such a release is refused, and the refusal is remembered so the asset is not
# downloaded again on every check. Installs are also counted in a
# `camon.update-guard` file beside the binary, and the same version is
# installed at most three times: that stops an update that installs but never
# comes back — a service starting a different binary than the updater replaces
# — from restarting camon indefinitely. Camon logs which of the two it hit and
# what to fix; deleting the guard file retries, and any newer release resets it.
# The download is fsynced before it is renamed over the running binary and the
# directory holding the name is fsynced after, so a power cut moments after an
# update cannot leave a truncated `camon` that never starts again.
enabled = false

[buffer]
# Hot buffer duration in seconds (default: 600 = 10 minutes)
hot_duration_secs = 600

[http]
# HTTP server port for web UI and API (default: 8080)
port = 8080
# Address to bind to (default: "0.0.0.0" = every interface, i.e. reachable from
# the whole LAN). Use "127.0.0.1" to keep the server on this machine only —
# right when a reverse proxy on the same host is the only client.
bind = "0.0.0.0"
# Access token for the API (default: none = anyone who can reach the port can
# watch all footage and change motion settings). When set, every request under
# /api must present it as an "Authorization: Bearer <token>" header. GET and
# HEAD requests may instead use a "?token=<token>" query parameter, which is
# how image and video URLs that cannot set headers authenticate; requests that
# change anything always need the header. The web UI asks for it once and
# remembers it in the browser's local storage; the UI shell itself stays
# unauthenticated so that prompt can load. An empty value is rejected at
# startup — use a long random one, e.g. `openssl rand -hex 32`.
# token = "s3cr3t-token"
# Silence the startup warning about an unauthenticated API on a non-loopback
# bind (default: false). Set true only when something in front of camon already
# authenticates — e.g. the Home Assistant add-on, where ingress does.
allow_open = false

[analytics]
# Enable MOG2 motion detection (default: false)
enabled = true
# Frame rate ffmpeg decodes at when pulling frames out of a motion run for
# object detection (default: 5). Motion analysis itself is keyframe-driven —
# one frame per keyframe, so about one per second at a 1-second GOP — and is
# not affected by this. Four frames per run reach the vision model whatever
# this is set to: a higher rate only widens what they are chosen from, it
# does not make the run hold more of them.
sample_fps = 5

# Default motion-detection settings. These seed each camera's
# motion_settings.json the first time it is seen; after that the per-camera
# file — edited live from the web UI (sensitivity slider, min-object-size
# slider, and two paintable 16x12 masks: the movement mask, which excludes
# cells from motion detection, and the detection mask, which blacks cells out
# of every frame sent to the vision model) — takes over. Detection is fully
# deterministic: there is no auto-tuning. Only the two sliders have config
# defaults; both masks default to all-off and are painted per camera.
[analytics.motion]
# MOG2 var_threshold. Higher = less sensitive. Range 4-96 (default: 16).
var_threshold = 16
# Minimum object size in foreground pixels. Range 50-2000 (default: 200).
min_contour_area = 200

# Object detection via Ollama (requires analytics enabled).
# All cameras share ONE detection worker that sends at most one request to
# Ollama at a time (strictly serial — kind to modest GPUs). Motion detection
# and event recording never wait for the model: events are written the moment
# a motion run ends and upgraded to object events when a verdict arrives.
[analytics.object_detection]
# Enable object detection on motion segments (default: false)
enabled = true
# Minimum confidence threshold (default: 0.5)
confidence_threshold = 0.5
# Object classes to detect. Omit the key for the defaults (person, car,
# truck, dog, cat). While enabled = true above, the list may not be empty and
# no entry may be blank: "detect nothing" is what enabled = false says, and
# camon will not guess which of the two an empty list meant.
# Also constrains the model's structured JSON output — only these classes can
# be returned. Trimmed, folded to lower case and deduplicated at load, so the
# Home Assistant entities and the model prompt always agree on the spelling.
classes = ["person", "car", "truck", "dog", "cat"]

[analytics.object_detection.ollama]
# Ollama server URL (default: http://localhost:11434)
url = "http://localhost:11434"
# Vision model to use (default: gemma4:e4b)
model = "gemma4:e4b"
# Per-request timeout in seconds (default: 90). Warm inference on a modest
# GPU takes up to ~50s per frame; a timeout only costs that event's object
# upgrade, never the footage.
timeout_secs = 90

# Optional fallback server if primary fails
# [analytics.object_detection.ollama.fallback]
# url = "http://backup:11434"
# model = "gemma3:4b"

[storage]
# Enable warm storage — write video to disk (default: true).
# With analytics enabled this is EVENT recording: only motion/object events are
# saved (to movements/ and objects/). With analytics DISABLED it becomes
# CONTINUOUS recording ("dumb NVR"): every segment is saved, chunked into
# continuous/. Continuous is heavy — roughly 43 GB/day/camera at 4 Mbps.
enabled = true
# Directory for event files (default: /var/camon/storage)
# On a dedicated volume, mount it here before starting camon: at startup camon
# drops a small ".camon-volume" marker in this directory and re-stats it once a
# minute, so a volume that is unmounted, swapped or mounted over while camon
# runs is reported at error level instead of silently redirecting every write
# to the filesystem behind the mountpoint. Recording carries on either way; the
# emergency prune below does not, since free space measured there is about the
# wrong disk. The marker is rewritten on every start, so it is safe to delete
# while camon is stopped.
data_dir = "/var/camon/storage"
# Seconds of context before first motion in an event (default: 5)
pre_padding_secs = 5
# Seconds of context after last motion in an event (default: 10)
post_padding_secs = 10
# Cap on a single event's length in seconds (default: 120). A run longer than
# this is split into chained, independently playable chunks — the follow-on
# chunks are flagged "continues" in their sidecar. In continuous mode this is
# also the length of each recording chunk. A recording must fit inside
# buffer.hot_duration_secs above, or its oldest segments are evicted before it
# can be written. With analytics enabled that means max_event_duration_secs +
# pre_padding_secs (an event reaches back that far before its first motion), and
# camon warns but keeps recording — long events just lose their opening seconds.
# In continuous mode it is the cap alone, since chunks are cut straight from the
# buffer with no padding, and camon refuses to start: nothing would roll a chunk,
# so no footage would be written at all. post_padding_secs never counts — it
# cannot push a chunk past the cap. 0 disables chunking:
# allowed with analytics enabled (motion end still closes each event), rejected
# in continuous mode, where the cap is the only thing that rolls a chunk and
# nothing would be written until shutdown. Timing runs on a monotonic clock
# rather than the camera's PTS, so a camera timestamp jump can't stall it.
max_event_duration_secs = 120
# Retention for movement-only events in days (default: 2). All three retentions
# below are whole days from 1 to 3650, checked at startup while storage is
# enabled. 0 is rejected: it does not mean "keep forever" but "expired the
# moment it was written", so every sweep would be deleting footage that was
# just recorded. The upper bound keeps the retention from overflowing into a very
# short one; a retention that long is really a disk-space limit, which is what
# min_free_bytes below is for.
#
# One task owns retention for the whole store and sweeps every camera hourly.
# A sweep deletes at most a quarter of a camera's events (at least four), so a
# clock corrected forward — routine on a box without a battery-backed clock,
# which resumes at its last shutdown time — cannot empty the archive in one
# pass: it warns and the rest survives for later sweeps. An event stays indexed
# and playable if its files could not be deleted, and the next sweep retries.
movement_retention_days = 2
# Retention for object detection events in days (default: 14)
object_retention_days = 14
# Retention for continuous-recording chunks in days (default: 1). Kept short by
# default because continuous recording is ~43 GB/day/camera at 4 Mbps.
continuous_retention_days = 1
# Minimum free space (bytes) to keep on the storage filesystem (default:
# 2147483648 = 2 GiB). Before each event write, if free space is below this,
# the oldest recordings are emergency-pruned — continuous first, then
# movements, then objects (cheapest to lose first) — until space recovers.
# 2 GiB is roughly an hour of footage at 4 Mbps, enough slack for the hourly
# retention prune to catch up, and keeps the filesystem out of the near-full
# regime where allocation degrades. 0 disables the guard. (Ignored by the
# remote stathost backend below, which measures against max_stored_bytes.)
# This pass skips events it has already failed to delete — the hourly sweep
# retries those — and is not bounded by that sweep's per-camera cap, since a
# disk that is actually full has to be freed.
min_free_bytes = 2147483648

# --- Remote warm-storage backend (optional) --------------------------------
# By default warm events go to the local data_dir above. Add a
# [storage.stathost] section to send them to a remote stathost static file host
# (github.com/nsg/stathost) instead. Analytics, motion settings, and the hot
# buffer always stay local; only the warm event store moves. Time-based
# retention (the *_retention_days above) still applies, via DELETE.
#
# Every request is bounded, because a warm writer awaits them inline: 10s to
# connect, 60s in total per delete, sidecar/thumbnail read or startup listing,
# and 300s per upload (an event video can be tens of megabytes on a slow
# uplink). Ranged playback has an idle budget of 30s instead of a total, so a
# player draining the body slowly is not cut off.
#
# Requires stathost 0.2.0 or later (atomic uploads, detailed listing, Range
# requests); there is no fallback for older servers. There are no directories
# on the host, so the .json sidecar is the only record of an event's type: it
# is uploaded before the video, which commits the event. An event whose sidecar
# cannot be stored is dropped rather than kept as a video that a later scan
# would read as a plain movement and delete on the wrong retention — except a
# plain movement event, which is what a sidecar-less video already reads as.
#
# [storage.stathost]
# # Base URL of the host.
# url = "https://files.example.com"
# # Bucket events are written into.
# bucket = "camon"
# # Per-bucket bearer token (sent as "Authorization: Bearer <token>").
# token = "s3cr3t-token"
# # Client-side storage budget in bytes (default: 0 = unlimited). The client
# # can't see the server's disk, so retention-by-space becomes a budget: when
# # tracked usage exceeds this, the oldest events are pruned (continuous →
# # movements → objects). 0 relies on time-based retention alone.
# max_stored_bytes = 0
# # Set false to keep this section but fall back to local-disk storage.
# enabled = true

# --- MQTT / Home Assistant integration (optional) --------------------------
# When enabled, camon connects to a broker and publishes Home Assistant MQTT
# discovery messages, creating one HA device per camera containing:
#   - a snapshot camera entity that updates only while motion is detected on
#     that camera (idle cameras stay quiet instead of republishing an image
#     every snapshot_interval_secs regardless of activity)
#   - a motion binary_sensor, on for the duration of a motion event
#   - one occupancy binary_sensor per class in
#     analytics.object_detection.classes above (e.g. "person", "car") — turns
#     on when that class is seen and clears occupancy_hold_secs after the
#     last sighting
#   - one snapshot camera entity per such class, showing the cropped frame
#     from the last sighting of that class (retained, so it persists across
#     restarts)
#
# Every state is published retained, so a bridge that dropped mid-motion would
# leave a stale ON standing in Home Assistant. On every connect camon therefore
# restates every configured entity explicitly — off as loudly as on — and
# publishes availability last, so nothing is marked available while the broker
# still holds an old value. Snapshots are dropped rather than queued while the
# broker is unreachable (an image would be long superseded by the time it could
# be delivered), and a snapshot decode gives up after 15 seconds.
#
# Discovery requires the Home Assistant MQTT integration to be configured
# with discovery enabled (the default).
#
# In the Home Assistant add-on this section normally does not need to be set
# at all: installing the Mosquitto broker add-on lets run.sh auto-configure
# host/port/username/password from the Supervisor, overriding whatever is
# set here.
#
# While MQTT is enabled, camera ids must not contain "+" or "#" (MQTT topic
# wildcards) and must stay unique once lowercased with non-alphanumerics
# folded to "_" ("Front Door" and "front-door" both become "front_door").
# The class names in analytics.object_detection.classes above reach the
# occupancy topics verbatim, so they must not hold a wildcard either. camon
# refuses to start otherwise.
[mqtt]
# Enable MQTT / Home Assistant discovery (default: false)
enabled = false
# Broker hostname (default: "localhost")
host = "localhost"
# Broker port (default: 1883)
port = 1883
# Broker username (optional, default: none)
# username = "camon"
# Broker password (optional, default: none)
# password = "s3cr3t"
# Prefix for camon's own state topics (default: "camon")
topic_prefix = "camon"
# Prefix the Home Assistant MQTT integration watches for discovery messages
# (default: "homeassistant")
discovery_prefix = "homeassistant"
# Renaming or removing a camera, dropping an object detection class, or moving
# either prefix leaves the entity's retained discovery message and state in the
# broker. camon remembers the set it announced — and the broker it announced it
# to — in {storage.data_dir}/mqtt_entities.json, and clears whatever the
# current set no longer describes on the next connect, before it marks the
# device available again. A record naming a different broker is never acted on.
# Classes are the one exception to "gone from the config means gone": a run
# with none (object detection off, or its vision server unreachable) keeps
# announcing the remembered ones, so their entities and history survive
# instead of being deleted by a temporary condition.
# How often the snapshot camera image is republished while motion is active,
# in seconds (default: 5)
snapshot_interval_secs = 5
# Seconds an occupancy sensor stays "on" after the last sighting of that
# class before it clears (default: 60)
occupancy_hold_secs = 60

# Camera definitions — add one [[cameras]] block per camera.
# Each id must be unique and is used verbatim as a directory name under
# storage.data_dir, so it must be a single path component: no "/", "\" or NUL,
# not "." or ".." on their own, not blank, and no leading/trailing whitespace.
# Anything else is fine, accents and punctuation included ("Trädgård",
# "Garage (side)"). See the [mqtt] notes above for the extra rules that apply
# only while the bridge is enabled.

[[cameras]]
id = "front-door"
url = "rtsp://admin:password@192.168.1.100:554/stream1"

# [[cameras]]
# id = "backyard"
# url = "rtsp://admin:password@192.168.1.101:554/stream1"
